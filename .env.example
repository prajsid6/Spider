# Spider Environment Configuration
# Provide your Supabase project URL and Anon (public) Key from https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public Razorpay key ID used by Checkout (never put the key secret here).
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Public VAPID key used by browser push subscriptions (private key is server-only).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
